CODEX_QUOTA_KEEPALIVE_TOKEN=replace-with-a-long-random-token
CODEX_QUOTA_KEEPALIVE_HOST=0.0.0.0
CODEX_QUOTA_KEEPALIVE_PORT=18766
CODEX_QUOTA_KEEPALIVE_INTERVAL_SECONDS=600
CODEX_QUOTA_KEEPALIVE_REQUEST_TIMEOUT_SECONDS=45
CODEX_QUOTA_KEEPALIVE_TIMEOUT_SECONDS=120
# Optional proxy settings. The installer can set these with --proxy/--no-proxy.
# HTTP_PROXY=http://proxy.example:7890
# HTTPS_PROXY=http://proxy.example:7890
# ALL_PROXY=http://proxy.example:7890
# NO_PROXY=localhost,127.0.0.1
CODEX_QUOTA_KEEPALIVE_STATE_FILE=/var/lib/codex-quota-keepalive/status.json
# Set this if Codex is not on the systemd service user's PATH.
# CODEX_DASHBOARD_CODEX_CMD=/usr/local/bin/codex
